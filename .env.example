# Nebius Token Factory. https://api.tokenfactory.nebius.com/v1/
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# These ids responded to a Token Factory probe. Small is used for search
# queries and the paper-mill signal. Large is used only for explanations.
CHAT_MODEL_SMALL=Qwen/Qwen3-30B-A3B-Instruct-2507
CHAT_MODEL_LARGE=Qwen/Qwen3-235B-A22B-Instruct-2507
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Length printed by the probe for Qwen/Qwen3-Embedding-8B.
EMBEDDING_DIMENSIONS=4096

DATABASE_URL=postgresql+psycopg://papertrail:papertrail@localhost:5432/papertrail

# Contact email sent as User-Agent to OpenAlex and Crossref.
SCHOLARLY_CONTACT_EMAIL=
# Free key from https://openalex.org/settings/api
OPENALEX_API_KEY=

MAX_CANDIDATES=30
MAX_LLM_CALLS_PER_RUN=40
MAX_PLANNER_ITERATIONS=8
CORS_ORIGINS=http://localhost:5173
